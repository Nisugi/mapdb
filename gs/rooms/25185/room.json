{
  "checksum": "543d2c56d72d698e8a28ecd1afaa0d78",
  "room": {
    "id": 25185,
    "title": [
      "[Dazh's Caravans, Conductor]"
    ],
    "description": [
      "Sweat and horseflesh conspire to form a tangy musk around the open-air business, which is astir with dozens of patrons with dustcloaks and knapsacks full of clothing, all gathered around a high counter at the center of the area.  A small fel sign sits atop the counter.  Stalls with horses and the occasional yierka line the western wall, tended by a team of sweating and overworked grooms.  The clank of wagons departing and arriving is a constant addition to the din."
    ],
    "paths": [
      "Obvious exits: none"
    ],
    "location": "the shadow of the Sanctum",
    "wayto": {
      "5579": "go caravansary",
      "25145": [
        {
          "do": "await",
          "cmd": "inquire",
          "timeout": 5,
          "on_timeout": "fail",
          "for": "(\\d)\\) the Sea of Fire",
          "bind": {
            "choice": 1
          }
        },
        {
          "do": "await",
          "cmd": "order {capture:choice}",
          "timeout": 5,
          "on_timeout": "continue",
          "for": "about the price of a trip to the Sea of Fire"
        },
        {
          "do": "await",
          "cmd": "order confirm",
          "timeout": 5,
          "on_timeout": "continue",
          "for": "It doesn't look like you have enough silver to ride\\.|We'll be taking that payment in silver, then\\.",
          "bind": {
            "paid": 0
          }
        },
        {
          "do": "if",
          "when": "capture_match:paid=enough silver to ride",
          "then": [
            {
              "do": "echo",
              "msg": "Not enough silver for the Sea of Fire caravan."
            },
            {
              "do": "break"
            }
          ]
        },
        {
          "do": "wait_until",
          "when": "room_name:Caravan, Wagon",
          "timeout": 120
        },
        {
          "do": "sleep",
          "seconds": 1
        },
        {
          "do": "wait_until",
          "when": "not:room_name:Caravan, Wagon",
          "timeout": 1800
        },
        {
          "do": "if",
          "when": "npc_match:thief|rogue|bandit|mugger|outlaw|highwayman|marauder|brigand|thug|robber",
          "then": [
            {
              "do": "echo",
              "msg": "BANDITS!!! BANDITS!!! BANDITS!!!"
            },
            {
              "do": "break"
            }
          ]
        },
        {
          "do": "if",
          "when": "not:in_room:25145",
          "then": [
            {
              "do": "replan"
            }
          ]
        }
      ]
    },
    "timeto": {
      "5579": 0.2,
      "25145": {
        "cost": 120,
        "requires": [
          "var:car_to_sos"
        ]
      }
    },
    "tags": [
      "caravan",
      "silver-cost:25145:3000"
    ],
