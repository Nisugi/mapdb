  "room": {
    "id": 18893,
    "title": [
      "[Cavern, Altar]"
    ],
    "description": [
      "An old, dusty altar is set in the center of this small raised area.  The wall behind the altar is bare except for a row of five rickety levers connected to a thick rope that leads upward.  Each lever has been painted a different color: yellow, blue, brown, red, and green.  The torch light flickers ominously across the walls and pillars that brace the heavy stone ceiling."
    ],
    "paths": [
      "Obvious paths: none"
    ],
    "location": "Ta'Illistim",
    "wayto": {
      "13441": [
        {
          "do": "await",
          "cmd": "look altar",
          "timeout": 10,
          "on_timeout": "fail",
          "for": "There is a strange grid on the altar",
          "bind_all": {
            "yellow": "Yellow ([0-9])",
            "blue": "Blue ([0-9])",
            "brown": "Brown ([0-9])",
            "red": "Red ([0-9])",
            "green": "Green ([0-9])"
          }
        },
        {
