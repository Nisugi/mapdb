{
  "checksum": "a973d5bece1e28fa6d72d6b7cd62a5c4",
  "room": {
    "id": 24980,
    "title": [
      "[Underground, Dead End]"
    ],
    "description": [
      "Colonies of stiptic fungus populate the otherwise dark space, their luminescence the only source of illumination.  Cramped and narrow, the damp earth all around seems to press inward in an inconsiderate manner, its capacious stalactites and stalagmites creating considerable barriers to movement.  Further frustrating the outlook for any appreciable forward or backward progress, there doesn't appear to be any obvious means of egress, save for up a slide-like slope that is far too steep and slick to climb."
    ],
    "paths": [
      "Obvious exits: none"
    ],
    "location": "Wehnimer's Landing",
    "wayto": {
      "24804": [
        {
          "do": "echo",
          "msg": "Waiting for the stain to show up..."
        },
        {
          "do": "await",
          "timeout": 600,
          "on_timeout": "fail",
          "for": "dark stains"
        },
        {
          "do": "send",
          "cmd": "get stain"
        },
        {
          "do": "if",
          "when": "status:standing",
          "then": [
            {
              "do": "send",
              "cmd": "lie"
            }
          ]
        },
        {
          "do": "repeat",
          "times": 30,
          "steps": [
            {
              "do": "await",
              "cmd": "search",
              "timeout": 3,
              "on_timeout": "continue",
              "for": "descending slope",
              "bind": {
                "slope": 0
              }
            },
            {
              "do": "if",
              "when": "capture:slope",
              "then": [
                {
                  "do": "break"
                }
              ]
            }
          ]
        },
        {
          "do": "await",
          "cmd": "go slope",
          "timeout": 3,
          "on_timeout": "continue",
          "for": "You gradually make your way down the descending slope"
        },
        {
          "do": "repeat",
          "times": 30,
          "steps": [
            {
              "do": "await",
              "cmd": "search",
              "timeout": 3,
              "on_timeout": "continue",
              "for": "opening",
              "bind": {
                "opening": 0
              }
            },
            {
              "do": "if",
              "when": "capture:opening",
              "then": [
                {
                  "do": "break"
                }
              ]
            }
          ]
        },
        {
          "do": "await",
          "cmd": "go opening",
          "timeout": 3,
          "on_timeout": "continue",
          "for": "You duck down low and half-crawl into the opening"
        },
        {
          "do": "repeat",
          "until": "status:standing",
          "steps": [
            {
              "do": "send",
              "cmd": "stand"
            }
          ]
        }
      ]
    },
    "timeto": {
      "24804": 2
    },
    "tags": [
      "missing"
    ]
  }
}